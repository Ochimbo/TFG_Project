/// Perfil del alumno: género x situación de edad x mes de nacimiento (2 x 7 x 13 = 182 filas). Clave = GeneroCodigo * 100000 + SituacionEdadCodigo * 10000 + EdadAnioNatural * 100 + MesNacimiento.
table DimPerfilAlumno
	lineageTag: 20b0edd2-9410-53ba-be77-cfbc6031b5fe

	/// Clave determinista: GeneroCodigo * 100000 + SituacionEdadCodigo * 10000 + (EdadAnioNatural o 0) * 100 + MesNacimiento (0 si no informado).
	column PerfilKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 43e4fd8c-86c4-5ad1-971c-f4d8576df81f
		summarizeBy: none
		sourceColumn: PerfilKey

		annotation SummarizationSetBy = User

	/// Género del alumno: Niña o Niño (R09).
	column Genero
		dataType: string
		lineageTag: bb14d750-a78a-508e-8e51-27a3a169ad15
		summarizeBy: none
		sourceColumn: Genero
		sortByColumn: GeneroCodigo

		annotation SummarizationSetBy = User

	/// 1 = Niña, 2 = Niño.
	column GeneroCodigo
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8b80ffe0-77c5-5f07-930e-265c0a144da5
		summarizeBy: none
		sourceColumn: GeneroCodigo

		annotation SummarizationSetBy = User

	/// Edad cumplida en el año natural de la prueba (Anio - año de nacimiento), entre 10 y 14. Vacía si falta, está fuera de rango, es 2010 o la fecha es de relleno (R16-R19).
	column EdadAnioNatural
		dataType: int64
		formatString: 0
		lineageTag: 5248ec00-5193-5bd3-80d4-de0ec49a74b1
		summarizeBy: none
		sourceColumn: EdadAnioNatural

		annotation SummarizationSetBy = User

	/// Situación respecto a la edad teórica de sexto (12 años): adelantado, edad teórica, retraso de 1 o 2 años, no fiable (2010) o desconocida (R21).
	column SituacionEdad
		dataType: string
		lineageTag: 428a01f8-3737-5814-ae57-91f979f774d7
		summarizeBy: none
		sourceColumn: SituacionEdad
		sortByColumn: SituacionEdadOrden

		annotation SummarizationSetBy = User

	/// 1 = edad teórica, 2 = retraso de 1 año, 3 = retraso de 2 años, 4 = adelantado, 8 = no fiable (2010), 9 = desconocida.
	column SituacionEdadCodigo
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a206285b-3e51-5ea1-8e72-aabdae71f5ba
		summarizeBy: none
		sourceColumn: SituacionEdadCodigo

		annotation SummarizationSetBy = User

	/// Orden de presentación de SituacionEdad (4, 1, 2, 3, 8, 9).
	column SituacionEdadOrden
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4a363c55-c423-5765-b0cd-4d991cd271cd
		summarizeBy: none
		sourceColumn: SituacionEdadOrden

		annotation SummarizationSetBy = User

	/// Mes de nacimiento 1-12; vacío si no está informado o es inválido.
	column MesNacimiento
		dataType: int64
		formatString: 0
		lineageTag: 6ab6f5cc-67dd-5424-b116-cb4d98bda26c
		summarizeBy: none
		sourceColumn: MesNacimiento

		annotation SummarizationSetBy = User

	/// Trimestre de nacimiento T1-T4, o No informado.
	column TrimestreNacimiento
		dataType: string
		lineageTag: 61ce30cc-e154-5675-a247-8e8f8cb11191
		summarizeBy: none
		sourceColumn: TrimestreNacimiento

		annotation SummarizationSetBy = User

	partition DimPerfilAlumno = m
		mode: import
		queryGroup: Dimensiones
		source =
				let
				    // R09: {GeneroCodigo, Genero}
				    Generos = {{1, "Niña"}, {2, "Niño"}},
				    // R21: {SituacionEdadCodigo, SituacionEdad, SituacionEdadOrden}; orden de presentación 4, 1, 2, 3, 8, 9
				    Situaciones = {
				        {4, "Adelantado", 1},
				        {1, "Edad teórica (12 años)", 2},
				        {2, "Retraso de 1 año", 3},
				        {3, "Retraso de 2 años", 4},
				        {8, "No fiable (2010)", 5},
				        {9, "Desconocida", 6}
				    },
				    // R16-R19, R21: combinaciones válidas {EdadAnioNatural (0 = sin edad), SituacionEdadCodigo}
				    Combinaciones = {{10, 4}, {11, 4}, {12, 1}, {13, 2}, {14, 3}, {0, 8}, {0, 9}},
				    // 2 géneros x 7 combinaciones x 13 meses (0 = no informado) = 182 filas. PerfilKey usa la
				    // misma fórmula que stg_Evaluaciones: Genero * 100000 + Situacion * 10000 + Edad * 100 + Mes.
				    Filas = List.Combine(
				        List.Transform(
				            Generos,
				            (genero) => List.Combine(
				                List.Transform(
				                    Combinaciones,
				                    (combinacion) =>
				                        let
				                            Situacion = List.First(List.Select(Situaciones, (s) => s{0} = combinacion{1}))
				                        in
				                            List.Transform(
				                                {0..12},
				                                (mes) => {
				                                    genero{0} * 100000 + combinacion{1} * 10000 + combinacion{0} * 100 + mes,
				                                    genero{1},
				                                    genero{0},
				                                    if combinacion{0} = 0 then null else combinacion{0},
				                                    Situacion{1},
				                                    Situacion{0},
				                                    Situacion{2},
				                                    if mes = 0 then null else mes,
				                                    if mes = 0 then "No informado" else "T" & Text.From(Number.IntegerDivide(mes - 1, 3) + 1)
				                                }
				                            )
				                )
				            )
				        )
				    ),
				    Resultado = #table(
				        type table [
				            PerfilKey = Int64.Type,
				            Genero = text,
				            GeneroCodigo = Int64.Type,
				            EdadAnioNatural = Int64.Type,
				            SituacionEdad = text,
				            SituacionEdadCodigo = Int64.Type,
				            SituacionEdadOrden = Int64.Type,
				            MesNacimiento = Int64.Type,
				            TrimestreNacimiento = text
				        ],
				        Filas
				    )
				in
				    Resultado

	annotation PBI_ResultType = Table

