/// Contexto del centro: área territorial x naturaleza x hábitat (15 x 2 x 4 = 120 filas). Clave = AreaCodigo * 100 + NaturalezaCodigo * 10 + HabitatCodigo.
table DimContextoCentro
	lineageTag: 477c0f81-0289-59c9-a584-3aed2b4a8e30

	/// Clave determinista: AreaCodigo * 100 + NaturalezaCodigo * 10 + HabitatCodigo.
	column ContextoKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7b7a5d6c-37fd-5ded-84a4-4428e20d5032
		summarizeBy: none
		sourceColumn: ContextoKey

		annotation SummarizationSetBy = User

	/// Código del área (contrato §5.1). 3 = Barcelona Comarques hasta 2023; 4 = Barcelona Comarques en 2024 (perímetro del Barcelonès); 99 = desconocida (R13, R14).
	column AreaCodigo
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: cc7cbe6f-143d-5697-ade4-9e82e12ca83e
		summarizeBy: none
		sourceColumn: AreaCodigo

		annotation SummarizationSetBy = User

	/// Área territorial tal como la publica el Departament (los códigos 3 y 4 comparten el nombre Barcelona Comarques).
	column AreaTerritorial
		dataType: string
		lineageTag: 37b767ea-765c-5a6b-9677-bbc8b3a0b4fc
		summarizeBy: none
		sourceColumn: AreaTerritorial
		sortByColumn: AreaOrden

		annotation SummarizationSetBy = User

	/// Área expresada con el perímetro territorial vigente en 2025 (R14).
	column AreaPerimetro2025
		dataType: string
		lineageTag: c3de7ab9-b4e2-5ef8-a8f0-23d7254dfdaf
		summarizeBy: none
		sourceColumn: AreaPerimetro2025

		annotation SummarizationSetBy = User

	/// Agrupación de áreas con serie temporal comparable a pesar de los cambios de perímetro de 2024-2025.
	column AreaSerieComparable
		dataType: string
		lineageTag: 5df98364-12b2-58ff-8bd2-f785120e2b93
		summarizeBy: none
		sourceColumn: AreaSerieComparable

		annotation SummarizationSetBy = User

	/// VERDADERO si el área cambió de perímetro y su serie no es comparable sin agrupar.
	column AreaConRupturaSerie
		dataType: boolean
		lineageTag: 03e3f452-8c72-53df-9209-abf6ebb27869
		summarizeBy: none
		sourceColumn: AreaConRupturaSerie

		annotation SummarizationSetBy = User

	/// VERDADERO en Girona y Maresme - Vallès Oriental, cuya clasificación de hábitat cambió en 2024.
	column RupturaHabitat2024
		dataType: boolean
		lineageTag: 69618dce-0fa8-503c-9363-31d59a088394
		summarizeBy: none
		sourceColumn: RupturaHabitat2024

