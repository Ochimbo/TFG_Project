model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-ES
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parámetros

	annotation PBI_QueryGroupOrder = 0

queryGroup Staging

	annotation PBI_QueryGroupOrder = 1

queryGroup Dimensiones

	annotation PBI_QueryGroupOrder = 2

queryGroup Hechos

	annotation PBI_QueryGroupOrder = 3

annotation PBI_QueryOrder = ["RutaDatos","stg_Evaluaciones","DimAnio","DimContextoCentro","DimPerfilAlumno","DimCompetencia","DimNivelLogro","DimCalidadDato","FactEvaluacion","FactPuntuacion","_Medidas"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table DimAnio
ref table DimContextoCentro
ref table DimPerfilAlumno
ref table DimCompetencia
ref table DimNivelLogro
ref table DimCalidadDato
ref table FactEvaluacion
ref table FactPuntuacion
ref table _Medidas
