EXTRA-9 2010: ¿qué columna está desordenada? área x naturaleza y área x puntuación
==============================================================================================================

-- SQL:
WITH a AS (SELECT anio, AREA_TERRITORIAL area, avg(n_PMAT) m FROM v WHERE anio BETWEEN 2009 AND 2011 GROUP BY ALL)
        SELECT round(corr(x.m, y.m), 3) AS corr_area_pmat_2009_2010,
               round(corr(x.m, z.m), 3) AS corr_area_pmat_2009_2011,
               round(corr(y.m, z.m), 3) AS corr_area_pmat_2010_2011
        FROM a x JOIN a y ON x.area = y.area AND x.anio = 2009 AND y.anio = 2010
                 JOIN a z ON z.area = x.area AND z.anio = 2011
   corr_area_pmat_2009_2010  corr_area_pmat_2009_2011  corr_area_pmat_2010_2011
0                     0.945                     0.913                     0.853

