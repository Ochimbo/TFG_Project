-- SQL:
WITH g AS (SELECT "ANY", "CODI_ALUMNE", "PCAT", "PCAT_CL", "PCAT_EE", "PCAST", "PCAST_CL", "PCAST_EE", "PMAT", "PMAT_NC", "PMAT_EFM", "PMAT_CR", "PANG", "PANG_CO", "PANG_CE", "PFRAN", "PFRAN_CO", "PFRAN_CE", "PANG_EE", "PFRAN_EE", "PCAT_CO", "PCAST_CO", "PMED", "PMED_COMP1", "PMED_COMP2", "PMED_COMP3", "GENERE", "MES_NAIXEMENT", "ANY_NAIXEMENT", "AREA_TERRITORIAL", "NATURALESA", "HABITAT", count(*) AS n FROM d GROUP BY ALL HAVING count(*) > 1)
         SELECT "ANY", CODI_ALUMNE IS NULL AS sin_codigo, count(*) AS grupos, sum(n) AS filas,
                sum(n) - count(*) AS filas_sobrantes
         FROM g GROUP BY ALL ORDER BY ALL
    ANY  sin_codigo  grupos  filas  filas_sobrantes
