         SELECT "ANY", n, (SELECT count(*) FROM (SELECT unnest([PCAT, PCAT_CL, PCAT_EE, PCAST, PCAST_CL, PCAST_EE, PMAT, PMAT_NC, PMAT_EFM, PMAT_CR, PANG, PANG_CO, PANG_CE, PFRAN, PFRAN_CO, PFRAN_CE, PANG_EE, PFRAN_EE, PCAT_CO, PCAST_CO, PMED, PMED_COMP1, PMED_COMP2, PMED_COMP3]) x) WHERE x IS NOT NULL) AS punt_informadas,
